// Prisma Schema cho Hệ thống Quản trị Nhà thuốc Doanh nghiệp PharmaCore ERP
// Đảm bảo giữ nguyên 10 trường bắt buộc của bảng Product + Mở rộng 8 bảng nghiệp vụ thực tế

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================================
// 1. BẢNG PRODUCT (Giữ đúng 10 trường bắt buộc theo yêu cầu chấm điểm)
// (ProductID, ProductName, PathImage, ProductType, Quantity, Unit, Price, Description, CreateDate, UpdateDate)
// ============================================================================
model Product {
  ProductID    Int      @id @default(autoincrement())
  ProductName  String
  PathImage    String   @default("https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400&auto=format&fit=crop&q=80")
  ProductType  String
  Quantity     Int      @default(0)
  Unit         String
  Price        Float    @default(0)
  Description  String
  CreateDate   DateTime @default(now())
  UpdateDate   DateTime @updatedAt

  invoiceItems       InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  packaging          ProductPackaging?
  stockLots          StockLot[]
  stockMovements     StockMovement[]
  onlineOrderItems   OnlineOrderItem[]
  reservations       InventoryReservation[]

  @@index([ProductType, CreateDate])
  @@index([ProductName])
}

// ============================================================================
// 1b. BẢNG QUY CÁCH ĐÓNG GÓI, GIÁ BÁN BUÔN & TỒN KHO LẺ DỞ DANG (PRODUCT_PACKAGING)
// ============================================================================
model ProductPackaging {
  PackagingID         Int      @id @default(autoincrement())
  ProductID           Int      @unique
  PackageUnit         String   // Đơn vị bao gói cơ sở (VD: "Hộp", "Lọ", "Chai", "Tuýp")
  CartonUnit          String?  @default("Thùng") // Đơn vị kiện bán buôn
  BoxesPerCarton      Int      @default(20)      // Số hộp trong 1 thùng bán buôn
  BlisterUnit         String?  // Đơn vị trung gian (VD: "Vỉ" nếu có)
  BlistersPerPackage  Int?     // Số vỉ trong 1 hộp (VD: 25)
  SmallestUnit        String   // Đơn vị nhỏ nhất có thể bán (VD: "Viên", "Gói", "Ống", "Chai")
  UnitsPerPackage     Int      @default(1) // Tổng số đơn vị nhỏ nhất trong 1 hộp (VD: 100 viên, 30 gói)
  UnitsPerBlister     Int?     // Số viên trong 1 vỉ (VD: 4 viên/vỉ)
  LooseUnits          Int      @default(0) // Số đơn vị nhỏ nhất lẻ dở dang đang mở trong kho
  ReservedBaseQty     Int      @default(0) // Số hộp nguyên đang được giữ tạm (Reservation) cho đơn chờ duyệt
  ReservedLooseUnits  Int      @default(0) // Số viên lẻ đang được giữ tạm (Reservation)
  Version             Int      @default(1) // Khóa Optimistic Concurrency chống race condition khi tranh hộp cuối
  AllowFractionalSale Boolean  @default(true) // Cho phép bán lẻ vỉ/viên
  WholesalePrice      Float?   // Giá bán buôn (B2B) trên 1 PackageUnit (Hộp)
  MinWholesaleQty     Int      @default(10) // Số lượng hộp tối thiểu áp dụng giá sỉ
  IsRx                Boolean  @default(false) // Phân loại thuốc kê đơn bắt buộc toa bác sĩ
  IsPublished         Boolean  @default(true)
  IsTestOnly          Boolean  @default(false)

  product             Product  @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)

  @@index([IsPublished, IsTestOnly])
}

// ============================================================================
// 1c. BẢNG TỒN KHO THEO LÔ & HẠN DÙNG CHUẨN FEFO (STOCK_LOT)
// ============================================================================
model StockLot {
  LotID             Int      @id @default(autoincrement())
  ProductID         Int
  BatchNumber       String
  ExpiryDate        String   // YYYY-MM-DD
  InitialQuantity   Int      @default(0)
  RemainingQuantity Int      @default(0)
  ImportPrice       Float    @default(0)
  BranchCode        String   @default("CS1-GPP")
  Status            String   @default("ACTIVE") // ACTIVE | EXPIRED | RECALLED | DEPLETED
  CreateDate        DateTime @default(now())

  product                   Product              @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)
  invoiceLotAllocations     InvoiceItemLot[]
  onlineOrderLotAllocations OnlineOrderItemLot[]

  @@index([ProductID, Status, ExpiryDate])
}

// ============================================================================
// 1d. BẢNG SỔ CÁI BIẾN ĐỘNG TỒN KHO APPEND-ONLY (STOCK_MOVEMENT)
// ============================================================================
model StockMovement {
  MovementID    Int      @id @default(autoincrement())
  ProductID     Int
  SourceType    String   // INVOICE | ONLINE_ORDER | PURCHASE_ORDER | STOCKTAKE
  SourceID      Int
  LineItemID    Int      @default(0)
  MovementType  String   // RESERVE | RELEASE | EXPORT | RETURN | IMPORT
  Unit          String
  Quantity      Int
  BaseQtyDelta  Int      @default(0)
  LooseQtyDelta Int      @default(0)
  BatchNumber   String?
  ExpiryDate    String?
  ActorUserID   Int?
  ActorName     String?
  Note          String?
  CreateDate    DateTime @default(now())

  product       Product  @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)

  @@unique([SourceType, SourceID, LineItemID, MovementType])
}

// ============================================================================
// 2. BẢNG NHÂN SỰ & PHÂN QUYỀN (USER)
// ============================================================================
model User {
  UserID     Int       @id @default(autoincrement())
  FullName   String
  Email      String    @unique
  Password   String
  Phone      String?
  Role         String    @default("PHARMACIST") // ADMIN | PHARMACIST | CASHIER
  Status       String    @default("ACTIVE")     // ACTIVE | INACTIVE
  TokenVersion Int       @default(1)
  CreateDate   DateTime  @default(now())

  invoices          Invoice[]
  purchaseOrders    PurchaseOrder[]
  contacts          Contact[]
  clinicalAuditLogs ClinicalAuditLog[]
}

// ============================================================================
// 3. BẢNG HỒ SƠ BỆNH NHÂN / KHÁCH SỈ ĐẠI LÝ & TIỀN SỬ DỊ ỨNG (CUSTOMER)
// ============================================================================
model Customer {
  CustomerID    Int       @id @default(autoincrement())
  CustomerCode  String    @unique
  FullName      String
  Phone         String    @unique
  Email         String?
  Gender        String    @default("Khác")
  BirthYear     Int?
  CustomerType  String    @default("RETAIL") // RETAIL (Khách lẻ/Bệnh nhân) | WHOLESALE (Đại lý/Phòng khám B2B)
  CompanyName   String?   // Tên Quầy thuốc / Phòng khám / Pháp nhân B2B
  TaxCode       String?   // Mã số thuế doanh nghiệp
  Address       String?   // Địa chỉ giao hàng / Trụ sở
  CreditLimit   Float     @default(50000000) // Hạn mức công nợ bán buôn tối đa
  DebtBalance   Float     @default(0)        // Dư nợ phải thu hiện tại
  Allergies     String    @default("Không có") // VD: "Dị ứng Penicillin, Amoxicillin"
  ChronicCond   String    @default("Không có") // VD: "Viêm loét dạ dày, Cao huyết áp"
  LoyaltyPoints Int       @default(0)
  CreateDate    DateTime  @default(now())

  invoices      Invoice[]
  onlineOrders  OnlineOrder[]
}

// ============================================================================
// 4. BẢNG NHÀ CUNG CẤP DƯỢC PHẨM (SUPPLIER)
// ============================================================================
model Supplier {
  SupplierID    Int             @id @default(autoincrement())
  SupplierCode  String          @unique
  SupplierName  String
  ContactPerson String
  Phone         String
  Email         String?
  Address       String
  TaxCode       String?
  CreateDate    DateTime        @default(now())

  purchaseOrders PurchaseOrder[]
}

// ============================================================================
// 5. BẢNG PHIẾU NHẬP KHO & CHI TIẾT LÔ NHẬP (PURCHASE_ORDER & ITEM)
// ============================================================================
model PurchaseOrder {
  PurchaseOrderID Int                 @id @default(autoincrement())
  OrderCode       String              @unique
  SupplierID      Int
  UserID          Int?
  TotalCost       Float               @default(0)
  Note            String?
  Status          String              @default("COMPLETED") // COMPLETED | CANCELLED
  CreateDate      DateTime            @default(now())

  supplier        Supplier            @relation(fields: [SupplierID], references: [SupplierID])
  user            User?               @relation(fields: [UserID], references: [UserID])
  items           PurchaseOrderItem[]
}

model PurchaseOrderItem {
  OrderItemID     Int           @id @default(autoincrement())
  PurchaseOrderID Int
  ProductID       Int
  Quantity        Int           @default(1)
  ImportPrice     Float         @default(0)
  BatchNumber     String
  ExpiryDate      String

  purchaseOrder   PurchaseOrder @relation(fields: [PurchaseOrderID], references: [PurchaseOrderID], onDelete: Cascade)
  product         Product       @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)
}

// ============================================================================
// 6. BẢNG HÓA ĐƠN BÁN HÀNG ĐA KÊNH: BÁN LẺ POS, BÁN BUÔN B2B & ONLINE
// ============================================================================
model Invoice {
  InvoiceID            Int                  @id @default(autoincrement())
  InvoiceCode          String               @unique
  OrderType            String               @default("RETAIL")    // RETAIL (Bán lẻ GPP) | WHOLESALE (Bán buôn B2B GDP)
  Channel              String               @default("POS")       // POS (Tại quầy) | ONLINE (Web nhà thuốc trực tuyến)
  FulfillmentStatus    String               @default("COMPLETED") // PENDING_REVIEW | CONFIRMED | PACKING | SHIPPING | DELIVERED | COMPLETED | CANCELLED | REJECTED
  PaymentStatus        String               @default("PAID")      // UNPAID | PARTIALLY_PAID | PAID | REFUNDED | VOID
  CustomerName         String
  CustomerPhone        String?
  CustomerID           Int?
  ShippingAddress      String?              // Địa chỉ giao hàng (snapshot độc lập)
  ShippingMethod       String?              // EXPRESS_2H | STANDARD | GDP_TRUCK | PICKUP
  ShippingFee          Float                @default(0)
  VatAmount            Float                @default(0)           // Thuế GTGT dược phẩm (5%)
  PaidAmount           Float                @default(0)           // Số tiền thực tế đã thu
  DebtAmount           Float                @default(0)           // Số tiền ghi công nợ phải thu
  RefundedAmount       Float                @default(0)           // Số tiền thực tế đã chi hoàn
  Note                 String?
  CancelReason         String?
  ClinicalOverrideCode String?
  ClinicalOverrideNote String?
  PrescriptionFileKey  String?
  PrescriptionFileMime String?
  CreatedByName        String?
  ApprovedByUserID     Int?
  ApprovedByName       String?
  ApprovedAt           DateTime?
  Discount             Float                @default(0)
  UsedPoints           Int                  @default(0)
  PointsDiscount       Float                @default(0)
  PointsEarned         Int                  @default(0)
  TotalAmount          Float                @default(0)
  Status               String               @default("COMPLETED") // COMPLETED | CANCELLED
  CreateDate           DateTime             @default(now())
  UpdateDate           DateTime             @updatedAt

  UserID               Int?
  user                 User?                @relation(fields: [UserID], references: [UserID])
  customer             Customer?            @relation(fields: [CustomerID], references: [CustomerID])
  items                InvoiceItem[]
  payment              Payment?
  paymentTransactions  PaymentTransaction[]
  onlineOrder          OnlineOrder?

  @@index([Status, CreateDate])
  @@index([CustomerID])
}

model InvoiceItem {
  ItemID               Int     @id @default(autoincrement())
  InvoiceID            Int
  ProductID            Int
  Quantity             Int     @default(1)
  Unit                 String?
  UnitPrice            Float   @default(0)
  BaseQuantityDeducted Int?
  LooseUnitsDeducted   Int?
  BatchNumber          String?
  ExpiryDate           String?
  LotID                Int?
  DosageNote           String?

  invoice        Invoice          @relation(fields: [InvoiceID], references: [InvoiceID], onDelete: Cascade)
  product        Product          @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)
  lotAllocations InvoiceItemLot[]
}

// ============================================================================
// 6b. BẢNG ĐƠN ĐẶT HÀNG ONLINE & GIỮ KHO TẠM CÓ HẠN (ONLINE_ORDER & RESERVATION)
// ============================================================================
model OnlineOrder {
  OrderID              Int                    @id @default(autoincrement())
  OrderCode            String                 @unique
  TrackingToken        String?
  TrackingTokenHash    String?                @unique
  TrackingExpiresAt    DateTime?
  OrderType            String                 @default("RETAIL") // RETAIL | WHOLESALE
  Status               String                 @default("PENDING_REVIEW") // PENDING_REVIEW | CONFIRMED | PACKING | SHIPPING | DELIVERED | REJECTED | CANCELLED | EXPIRED
  PaymentStatus        String                 @default("UNPAID") // UNPAID | PARTIALLY_PAID | PAID | REFUNDED | VOID
  PaymentMethod        String                 @default("COD")    // COD | VIETQR | CREDIT
  CustomerID           Int?
  CustomerName         String
  CustomerPhone        String
  ShippingAddress      String
  ShippingMethod       String                 @default("EXPRESS_2H") // EXPRESS_2H | STANDARD | GDP_TRUCK
  SubTotal             Float                  @default(0)
  ShippingFee          Float                  @default(0)
  VatAmount            Float                  @default(0)
  Discount             Float                  @default(0)
  TotalAmount          Float                  @default(0)
  PaidAmount           Float                  @default(0)
  Note                 String?
  PatientAllergies     String?
  PrescriptionFileKey  String?
  PrescriptionFileMime String?
  ReservedUntil        DateTime?
  ClinicalSafetyStatus String                 @default("PENDING") // SAFE | WARNING_REQUIRES_REVIEW | APPROVED_WITH_OVERRIDE | REJECTED
  ClinicalWarningsJson String?
  ClinicalReviewNote   String?
  ReviewedByUserID     Int?
  ReviewedByName       String?
  ReviewedAt           DateTime?
  RejectCancelReason   String?
  CourierTrackingCode  String?
  InvoiceID            Int?                   @unique
  CreateDate           DateTime               @default(now())
  UpdateDate           DateTime               @updatedAt

  customer             Customer?              @relation(fields: [CustomerID], references: [CustomerID])
  invoice              Invoice?               @relation(fields: [InvoiceID], references: [InvoiceID])
  items                OnlineOrderItem[]
  reservations         InventoryReservation[]

  @@index([Status, CreateDate])
  @@index([CustomerPhone])
  @@index([TrackingExpiresAt])
}

model OnlineOrderItem {
  OrderItemID      Int                   @id @default(autoincrement())
  OrderID          Int
  ProductID        Int
  Quantity         Int                   @default(1)
  Unit             String
  UnitPrice        Float                 @default(0)
  BaseQtyReserved  Int                   @default(0)
  LooseQtyReserved Int                   @default(0)
  BatchNumber      String?
  ExpiryDate       String?
  DosageNote       String?

  order            OnlineOrder           @relation(fields: [OrderID], references: [OrderID], onDelete: Cascade)
  product          Product               @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)
  reservation      InventoryReservation?
  lotAllocations   OnlineOrderItemLot[]
}

model InventoryReservation {
  ReservationID    Int             @id @default(autoincrement())
  OrderID          Int
  OrderItemID      Int             @unique
  ProductID        Int
  Unit             String
  Quantity         Int
  BaseQtyReserved  Int             @default(0)
  LooseQtyReserved Int             @default(0)
  Status           String          @default("ACTIVE") // ACTIVE | CONSUMED | RELEASED | EXPIRED
  ExpiresAt        DateTime
  ReleasedAt       DateTime?
  CreateDate       DateTime        @default(now())

  order            OnlineOrder     @relation(fields: [OrderID], references: [OrderID], onDelete: Cascade)
  orderItem        OnlineOrderItem @relation(fields: [OrderItemID], references: [OrderItemID], onDelete: Cascade)
  product          Product         @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)

  @@index([Status, ExpiresAt])
}

// ============================================================================
// 7. BẢNG SỔ QUỸ & GIAO DỊCH THANH TOÁN APPEND-ONLY (PAYMENT & PAYMENT_TRANSACTION)
// ============================================================================
model Payment {
  PaymentID       Int      @id @default(autoincrement())
  InvoiceID       Int      @unique
  PaymentMethod   String   @default("CASH") // CASH | VIETQR | CARD | COD | CREDIT
  TransactionCode String?
  PaidAmount      Float    @default(0)
  Status          String   @default("COMPLETED") // COMPLETED | PARTIAL | UNPAID | REFUNDED | VOID
  PaymentDate     DateTime @default(now())

  invoice         Invoice  @relation(fields: [InvoiceID], references: [InvoiceID], onDelete: Cascade)
}

model PaymentTransaction {
  TransactionID Int      @id @default(autoincrement())
  InvoiceID     Int
  EntryType     String   // CAPTURE | COLLECT_COD | DEBT_COLLECTION | REFUND | VOID
  PaymentMethod String   // CASH | VIETQR | CARD | COD | CREDIT
  Amount        Float    @default(0)
  ReferenceCode String?
  ActorUserID   Int?
  ActorName     String?
  Note          String?
  Status        String   @default("COMPLETED")
  CreateDate    DateTime @default(now())

  invoice       Invoice  @relation(fields: [InvoiceID], references: [InvoiceID], onDelete: Cascade)
}

// ============================================================================
// 7b. BẢNG KHÓA CHỐNG LẶP REQUEST (IDEMPOTENCY_RECORD)
// ============================================================================
model IdempotencyRecord {
  Id             Int      @id @default(autoincrement())
  IdempotencyKey String
  Scope          String
  ActorKey       String
  PayloadHash    String
  Status         String   @default("COMPLETED") // IN_PROGRESS | COMPLETED
  StatusCode     Int      @default(200)
  ResponseJson   String   @default("")
  CreateDate     DateTime @default(now())

  @@unique([Scope, ActorKey, IdempotencyKey])
  @@index([CreateDate])
}

// ============================================================================
// 8. BẢNG TƯ VẤN DƯỢC LÂM SÀNG & CSKH (CONTACT)
// ============================================================================
model Contact {
  ContactID   Int      @id @default(autoincrement())
  FullName    String
  Email       String
  Phone       String
  Subject     String
  Message     String
  Priority    String   @default("NORMAL") // HIGH | NORMAL | LOW
  ReplyNote   String?
  Status      String   @default("NEW")    // NEW | REPLIED | CLOSED
  CreateDate  DateTime @default(now())

  UserID      Int?
  user        User?    @relation(fields: [UserID], references: [UserID])

  @@index([Status, CreateDate])
}

// ============================================================================
// 9. BẢNG PHÂN BỔ LÔ CHÍNH XÁC CHO HÓA ĐƠN & ĐƠN ONLINE (D1 - FEFO MULTI-LOT)
// ============================================================================
model InvoiceItemLot {
  AllocationID Int         @id @default(autoincrement())
  ItemID       Int
  LotID        Int
  BatchNumber  String
  ExpiryDate   String
  Quantity     Int

  invoiceItem  InvoiceItem @relation(fields: [ItemID], references: [ItemID], onDelete: Cascade)
  stockLot     StockLot    @relation(fields: [LotID], references: [LotID])

  @@index([ItemID])
  @@index([LotID])
}

model OnlineOrderItemLot {
  AllocationID Int             @id @default(autoincrement())
  OrderItemID  Int
  LotID        Int
  BatchNumber  String
  ExpiryDate   String
  Quantity     Int

  onlineOrderItem OnlineOrderItem @relation(fields: [OrderItemID], references: [OrderItemID], onDelete: Cascade)
  stockLot        StockLot        @relation(fields: [LotID], references: [LotID])

  @@index([OrderItemID])
  @@index([LotID])
}

// ============================================================================
// 10. NHẬT KÝ THẨM ĐỊNH DƯỢC LÂM SÀNG & OVERRIDE (S1/S2/S3 CLINICAL AUDIT LOG)
// ============================================================================
model ClinicalAuditLog {
  AuditID        Int       @id @default(autoincrement())
  ActorUserID    Int
  ActorName      String
  ActorRole      String
  ContextType    String    // POS_INVOICE | ONLINE_ORDER_REVIEW
  InvoiceID      Int?
  OnlineOrderID  Int?
  CustomerID     Int?
  PatientAllergies String?
  Action         String    // OVERRIDE_ALLERGY | OVERRIDE_INTERACTION | APPROVE_RX | REJECT_RX
  ReasonCode     String
  ReasonNote     String
  WarningsJson   String
  RuleVersion    String
  CreateDate     DateTime  @default(now())

  actor          User      @relation(fields: [ActorUserID], references: [UserID])

  @@index([ContextType, CreateDate])
  @@index([InvoiceID])
  @@index([OnlineOrderID])
}
