// Prisma Schema cho Hệ thống Quản trị Nhà thuốc Doanh nghiệp PharmaCore ERP
// Đảm bảo giữ nguyên 10 trường bắt buộc của bảng Product + Mở rộng 8 bảng nghiệp vụ thực tế

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. BẢNG PRODUCT (Giữ đúng 10 trường bắt buộc theo yêu cầu chấm điểm)
// (ProductID, ProductName, PathImage, ProductType, Quantity, Unit, Price, Description, CreateDate, UpdateDate)
// ============================================================================
model Product {
  ProductID    Int      @id @default(autoincrement())
  ProductName  String
  PathImage    String   @default("https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400&auto=format&fit=crop&q=80")
  ProductType  String
  Quantity     Int      @default(0)
  Unit         String
  Price        Float    @default(0)
  Description  String
  CreateDate   DateTime @default(now())
  UpdateDate   DateTime @updatedAt

  invoiceItems       InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  packaging          ProductPackaging?
}

// ============================================================================
// 1b. BẢNG QUY CÁCH ĐÓNG GÓI & QUẢN LÝ TỒN KHO LẺ DỞ DANG (PRODUCT_PACKAGING)
// ============================================================================
model ProductPackaging {
  PackagingID         Int      @id @default(autoincrement())
  ProductID           Int      @unique
  PackageUnit         String   // Đơn vị bao gói lớn nhất (VD: "Hộp", "Lọ", "Chai", "Tuýp")
  BlisterUnit         String?  // Đơn vị trung gian (VD: "Vỉ" nếu có)
  BlistersPerPackage  Int?     // Số vỉ trong 1 hộp (VD: 25)
  SmallestUnit        String   // Đơn vị nhỏ nhất có thể bán (VD: "Viên", "Gói", "Ống", "Chai")
  UnitsPerPackage     Int      @default(1) // Tổng số đơn vị nhỏ nhất trong 1 hộp (VD: 100 viên, 30 gói)
  UnitsPerBlister     Int?     // Số viên trong 1 vỉ (VD: 4 viên/vỉ)
  LooseUnits          Int      @default(0) // Số đơn vị nhỏ nhất lẻ dở dang đang mở trong kho
  AllowFractionalSale Boolean  @default(true) // Cho phép bán lẻ vỉ/viên

  product             Product  @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)
}

// ============================================================================
// 2. BẢNG NHÂN SỰ & PHÂN QUYỀN (USER)
// ============================================================================
model User {
  UserID     Int       @id @default(autoincrement())
  FullName   String
  Email      String    @unique
  Password   String
  Phone      String?
  Role       String    @default("PHARMACIST") // ADMIN | PHARMACIST | CASHIER
  Status     String    @default("ACTIVE")     // ACTIVE | INACTIVE
  CreateDate DateTime  @default(now())

  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  contacts       Contact[]
}

// ============================================================================
// 3. BẢNG HỒ SƠ BỆNH NHÂN / KHÁCH HÀNG & TIỀN SỬ DỊ ỨNG (CUSTOMER)
// ============================================================================
model Customer {
  CustomerID    Int       @id @default(autoincrement())
  CustomerCode  String    @unique
  FullName      String
  Phone         String    @unique
  Email         String?
  Gender        String    @default("Khác")
  BirthYear     Int?
  Allergies     String    @default("Không có") // VD: "Dị ứng Penicillin, Amoxicillin"
  ChronicCond   String    @default("Không có") // VD: "Viêm loét dạ dày, Cao huyết áp"
  LoyaltyPoints Int       @default(0)
  CreateDate    DateTime  @default(now())

  invoices      Invoice[]
}

// ============================================================================
// 4. BẢNG NHÀ CUNG CẤP DƯỢC PHẨM (SUPPLIER)
// ============================================================================
model Supplier {
  SupplierID    Int             @id @default(autoincrement())
  SupplierCode  String          @unique
  SupplierName  String
  ContactPerson String
  Phone         String
  Email         String?
  Address       String
  TaxCode       String?
  CreateDate    DateTime        @default(now())

  purchaseOrders PurchaseOrder[]
}

// ============================================================================
// 5. BẢNG PHIẾU NHẬP KHO & CHI TIẾT LÔ NHẬP (PURCHASE_ORDER & ITEM)
// ============================================================================
model PurchaseOrder {
  PurchaseOrderID Int                 @id @default(autoincrement())
  OrderCode       String              @unique
  SupplierID      Int
  UserID          Int?
  TotalCost       Float               @default(0)
  Note            String?
  Status          String              @default("COMPLETED") // COMPLETED | CANCELLED
  CreateDate      DateTime            @default(now())

  supplier        Supplier            @relation(fields: [SupplierID], references: [SupplierID])
  user            User?               @relation(fields: [UserID], references: [UserID])
  items           PurchaseOrderItem[]
}

model PurchaseOrderItem {
  OrderItemID     Int           @id @default(autoincrement())
  PurchaseOrderID Int
  ProductID       Int
  Quantity        Int           @default(1)
  ImportPrice     Float         @default(0)
  BatchNumber     String        @default("LOT-2026A")
  ExpiryDate      String        @default("2028-12-31")

  purchaseOrder   PurchaseOrder @relation(fields: [PurchaseOrderID], references: [PurchaseOrderID], onDelete: Cascade)
  product         Product       @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)
}

// ============================================================================
// 6. BẢNG HÓA ĐƠN BÁN HÀNG & CHI TIẾT ĐƠN THUỐC (INVOICE & INVOICE_ITEM)
// ============================================================================
model Invoice {
  InvoiceID     Int           @id @default(autoincrement())
  InvoiceCode   String        @unique
  CustomerName  String
  CustomerPhone String?
  CustomerID    Int?
  Note          String?
  Discount      Float         @default(0)
  UsedPoints    Int           @default(0)
  PointsDiscount Float        @default(0)
  PointsEarned  Int           @default(0)
  TotalAmount   Float         @default(0)
  Status        String        @default("PAID") // PAID | REFUNDED
  CreateDate    DateTime      @default(now())
  UpdateDate    DateTime      @updatedAt

  UserID        Int?
  user          User?         @relation(fields: [UserID], references: [UserID])
  customer      Customer?     @relation(fields: [CustomerID], references: [CustomerID])
  items         InvoiceItem[]
  payment       Payment?
}

model InvoiceItem {
  ItemID               Int     @id @default(autoincrement())
  InvoiceID            Int
  ProductID            Int
  Quantity             Int     @default(1)
  Unit                 String?
  UnitPrice            Float   @default(0)
  BaseQuantityDeducted Int?
  LooseUnitsDeducted   Int?
  DosageNote           String?

  invoice     Invoice @relation(fields: [InvoiceID], references: [InvoiceID], onDelete: Cascade)
  product     Product @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)
}

// ============================================================================
// 7. BẢNG SỔ QUỸ & GIAO DỊCH THANH TOÁN (PAYMENT)
// ============================================================================
model Payment {
  PaymentID       Int      @id @default(autoincrement())
  InvoiceID       Int      @unique
  PaymentMethod   String   @default("CASH") // CASH | VIETQR | CARD
  TransactionCode String?
  PaidAmount      Float    @default(0)
  Status          String   @default("COMPLETED") // COMPLETED | REFUNDED
  PaymentDate     DateTime @default(now())

  invoice         Invoice  @relation(fields: [InvoiceID], references: [InvoiceID], onDelete: Cascade)
}

// ============================================================================
// 8. BẢNG TƯ VẤN DƯỢC LÂM SÀNG & CSKH (CONTACT)
// ============================================================================
model Contact {
  ContactID   Int      @id @default(autoincrement())
  FullName    String
  Email       String
  Phone       String
  Subject     String
  Message     String
  Priority    String   @default("NORMAL") // HIGH | NORMAL | LOW
  ReplyNote   String?
  Status      String   @default("NEW")    // NEW | REPLIED | CLOSED
  CreateDate  DateTime @default(now())

  UserID      Int?
  user        User?    @relation(fields: [UserID], references: [UserID])
}
